<?xml version="1.0"?>
<model>
  <name>Fixed RGBD Camera</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>UR3 Convenience ENV</name>
  </author>
  <description>
    Fixed RGB-D camera with separate type="camera" and type="depth" sensors.
    RGB image: /camera/image
    Depth image: /camera/depth_image
    Camera info: /camera/image/camera_info
    Camera looks in the +X direction of the link frame.
    Place with yaw=PI to face -X world direction (toward robot).
  </description>
</model>
